LimitRequestBody 150000000
php_value post_max_size 120M
php_value upload_max_filesize 100M

Options -Indexes

RewriteEngine On
    # Retired legacy administrator features are absent from the deployment.
    RewriteRule ^admin/pages/(?:admission|member|employment|calendar|sms)(?:/|$) - [R=404,L,NC]
    RewriteCond %{HTTP_HOST} ^(?:gate\.bluesquare\.kr|blue-gate\.qa\.local|gate\.local)(?::[0-9]+)?$ [NC]
    RewriteRule ^pages/(?:admission|member|employment|calendar|sms)(?:/|$) - [R=404,L,NC]
    # Internal gate URLs use the same filesystem and DB; no directory redirect.
    RewriteCond %{HTTP_HOST} ^(?:gate\.bluesquare\.kr|blue-gate\.qa\.local)(?::[0-9]+)?$ [NC]
    RewriteCond %{THE_REQUEST} \s/+admin(?:[/\s?]) [NC]
    RewriteRule ^ - [R=404,L]
RewriteRule (^|/)\. - [F,L]
RewriteRule \.(sql|log|md|bak|backup|old|test)$ - [F,L,NC]
RewriteRule (^|/)composer\.(json|lock)$ - [F,L,NC]
RewriteRule ^(qa|sql)/ - [R=404,L,NC]
RewriteRule (^|/)(vendor/.*/(examples?|tests?)|index\.test\.php|test\.js)$ - [R=404,L,NC]
RewriteRule ^resource/vendor/(?:fullPage\.js-2\.9\.7/(?:examples|tests)|tinymce/plugins/(?:example|jbimages))(?:/|$) - [R=404,L,NC]
RewriteRule ^uploads/board/file_ - [F,L,NC]
RewriteRule ^uploads/popup/.*(?:^|[_-])test(?:[_-]|\.) - [F,L,NC]

RewriteCond %{HTTP_HOST} ^(?:gate\.bluesquare\.kr|blue-gate\.qa\.local)(?::[0-9]+)?$ [NC]
RewriteRule ^(?:resource/(?:vendor|images)|uploads|inc/lib/captcha\.[^/]+\.php)(?:/|$) - [L,NC]
RewriteCond %{HTTP_HOST} ^(?:gate\.bluesquare\.kr|blue-gate\.qa\.local)(?::[0-9]+)?$ [NC]
RewriteRule ^admin(?:/|$) - [L,NC]
RewriteCond %{HTTP_HOST} ^(?:gate\.bluesquare\.kr|blue-gate\.qa\.local)(?::[0-9]+)?$ [NC]
RewriteRule ^(.*)$ admin/$1 [END]

# Development gate.local keeps legacy QA compatibility unless internal is selected.
RewriteCond %{HTTP_HOST} ^gate\.local(?::[0-9]+)?$ [NC]
RewriteCond %{ENV:GATE_ROUTE_MODE} ^internal$ [NC]
RewriteCond %{THE_REQUEST} \s/+admin(?:[/\s?]) [NC]
RewriteRule ^ - [R=404,L]
RewriteCond %{HTTP_HOST} ^gate\.local(?::[0-9]+)?$ [NC]
RewriteCond %{ENV:GATE_ROUTE_MODE} ^internal$ [NC]
RewriteRule ^(?:resource/(?:vendor|images)|uploads|inc/lib/captcha\.[^/]+\.php)(?:/|$) - [L,NC]
RewriteCond %{HTTP_HOST} ^gate\.local(?::[0-9]+)?$ [NC]
RewriteCond %{ENV:GATE_ROUTE_MODE} ^internal$ [NC]
RewriteRule ^admin(?:/|$) - [L,NC]
RewriteCond %{HTTP_HOST} ^gate\.local(?::[0-9]+)?$ [NC]
RewriteCond %{ENV:GATE_ROUTE_MODE} ^internal$ [NC]
RewriteRule ^(.*)$ admin/$1 [END]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
