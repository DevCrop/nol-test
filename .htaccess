# Upload limits
LimitRequestBody 115343360

<IfModule mod_php.c>
    php_value upload_max_filesize 110M
    php_value post_max_size 110M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>

<IfModule mod_rewrite.c>
    Options +FollowSymLinks
    RewriteEngine On

    # Deny environment backups/prepared deployment files as well as .env itself.
    RewriteRule (^|/)\.env(?:\.[^/]*)?(?:/|$) - [R=404,L,NC]

    # Shared-hosting gate: the provider must first send this host to this account.
    # Keep the browser URL at /; do not expose the physical admin directory.
    RewriteCond %{HTTP_HOST} ^gate\.noltheater-daehakro\.com(?::[0-9]+)?$ [NC]
    RewriteCond %{THE_REQUEST} \s/+nol-gate(?:[/\s?]) [NC]
    RewriteRule ^ - [R=404,L]

    RewriteCond %{ENV:GATE_ENFORCE} ^(true|1|on)$ [NC]
    RewriteCond %{HTTP_HOST} !^gate\.noltheater-daehakro\.com(?::[0-9]+)?$ [NC]
    RewriteRule ^nol-gate(?:/|$) - [R=404,L,NC]

    RewriteRule ^(?:inc|src|config|bootstrap|routes|sql|qa|storage)(?:/|$) - [R=404,L,NC]
    RewriteRule ^resource/vendor/(?:fullPage\.js-2\.9\.7/(?:examples|tests)|tinymce/plugins/example)(?:/|$) - [R=404,L,NC]
    RewriteRule ^resource/vendor/tinymce/plugins/jbimages(?:/|$) - [R=404,L,NC]
    RewriteRule \.(?:sql|bak|old|orig|env)$ - [R=404,L,NC]

    # Shared files must retain their child directory access rules.
    RewriteRule ^uploads/request(?:/|$) - [R=403,L,NC]
    RewriteRule ^uploads/.*\.(?:php[0-9]?|phtml|phar)(?:/|$) - [R=403,L,NC]

    # These resources live outside nol-gate, just like the dedicated vhost aliases.
    RewriteCond %{HTTP_HOST} ^gate\.noltheater-daehakro\.com(?::[0-9]+)?$ [NC]
    RewriteRule ^(?:resource/(?:vendor|images)|captcha|uploads)(?:/|$) - [L,NC]

    RewriteCond %{HTTP_HOST} ^gate\.noltheater-daehakro\.com(?::[0-9]+)?$ [NC]
    RewriteRule ^nol-gate(?:/|$) - [L,NC]

    RewriteCond %{HTTP_HOST} ^gate\.noltheater-daehakro\.com(?::[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ nol-gate/$1 [END]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>
