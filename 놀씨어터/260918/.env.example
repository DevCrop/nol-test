APP_ENV=development

# Docker
COMPOSE_PROJECT_NAME=noltheater
WEB_PORT=8618
DB_HOST_PORT=3318
PMA_PORT=9618
DB_ROOT_PASSWORD=

# 사이트
PUBLIC_HOST=noltheater-daehakro.com
GATE_HOST=gate.local
# 공개 호스트 /nol-gate 404. GATE 주소만 사용
GATE_ENFORCE=true
ADMIN_DIR=nol-gate

# 로컬 예시. 운영에서 실 도메인으로 교체
# 예: https://noltheater-daehakro.com,https://gate.noltheater-daehakro.com
CORS_ORIGINS=http://localhost:8618,http://gate.local:8618

# DB — 값은 .env에만. 여기 비밀번호 넣지 말 것
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# MFA SMTP — 고객 계정 오면 채움
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=NOL Theater

MFA_ENABLED=false
MFA_TO=
MFA_CODE_LENGTH=6
MFA_TTL_SECONDS=900
MFA_MAX_ATTEMPTS=5

# GATE IP. 콤마 구분. 예: 1.2.3.4,10.0.0.0/8
GATE_ALLOW_IPS=

# 세션. SESSION_LIFETIME은 관리자 무활동 자동 로그아웃 기준. domain은 GATE만. 메인도메인에 찍지 말 것
SESSION_NAME=NOLGATESESSID
SESSION_LIFETIME=1800
SESSION_DOMAIN=
SESSION_SECURE=false
SESSION_SAMESITE=Lax

# CSRF
CSRF_TTL_SECONDS=7200

# 관리자 장기 미접속 잠금 (일). 0이면 끔
ACCOUNT_IDLE_DAYS=90

# 비밀번호 변경 주기 (일). 0이면 끔
PASSWORD_MAX_DAYS=90
