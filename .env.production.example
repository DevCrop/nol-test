# 운영 전용 양식. 이 파일을 배포 설정으로 직접 사용하지 말고 프로젝트별 .env에 실제 값을 넣으세요.
APP_ENV=production
PUBLIC_HOST=
GATE_HOST=
GATE_ENFORCE=true
GATE_ALLOW_IPS=
TRUSTED_PROXY_CIDRS=
CORS_ORIGINS=
ADMIN_DIR=nol-gate
SESSION_NAME=BLUESQGATESESSID
SESSION_LIFETIME=1800
SESSION_SECURE=true
SESSION_SAMESITE=Lax
MFA_ENABLED=true
MFA_TTL_SECONDS=900
MFA_MAX_ATTEMPTS=5
MFA_RESEND_SECONDS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=블루스퀘어
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900
PASSWORD_MAX_DAYS=90
ACCOUNT_IDLE_DAYS=90
DB_HOST=
DB_PORT=3306
DB_NAME=dbusrbluesq0211
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
