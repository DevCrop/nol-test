# 운영 전용 양식. 이 파일을 배포 설정으로 직접 사용하지 말고 프로젝트별 .env에 실제 값을 넣으세요.
APP_ENV=production
# TEMPORARY ONLY: true permits unencrypted authentication on the exact GATE_HOST.
# Keep SESSION_SECURE=true; secure cookies remain mandatory on HTTPS/public hosts.
# Set false after gate SSL installation to enforce HTTPS again.
GATE_ALLOW_HTTP=false
PUBLIC_HOST=
GATE_HOST=
GATE_ENFORCE=true
# Temporary existing public HTTPS /nol-gate access; false again after gate SSL acceptance.
GATE_ALLOW_LEGACY_ADMIN=false
GATE_ALLOW_IPS=
TRUSTED_PROXY_CIDRS=
CORS_ORIGINS=
ADMIN_DIR=nol-gate
GATE_ROUTE_MODE=php
SESSION_NAME=NOLGATESESSID
SESSION_LIFETIME=1800
SESSION_SECURE=true
SESSION_SAMESITE=Lax
MFA_ENABLED=true
MFA_TTL_SECONDS=900
MFA_MAX_ATTEMPTS=5
MFA_RESEND_SECONDS=30
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=gate@nol-theater.com
SMTP_PASS=
SMTP_FROM=daehakro@nol-theater.com
SMTP_FROM_NAME=놀씨어터
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900
PASSWORD_MAX_DAYS=90
ACCOUNT_IDLE_DAYS=90
DB_HOST=
DB_PORT=3306
DB_NAME=dbusrdaehakro0605
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
